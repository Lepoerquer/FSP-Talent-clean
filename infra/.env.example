# Environment Configuration for FSP-Talent Platform

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=fsp-talent-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auth Provider ("internal" for standalone dev/CI, "keycloak" for OIDC)
AUTH_PROVIDER=internal
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=fsp-realm
KEYCLOAK_CLIENT_ID=fsp-backend

# Database
POSTGRES_USER=fsp_user
POSTGRES_PASSWORD=fsp_password
POSTGRES_DB=fsp_talent
DATABASE_URL=postgresql://fsp_user:fsp_password@localhost:5432/fsp_talent

# Valkey / Cache
VALKEY_URL=redis://localhost:6379/0

# External Mock Services
FSP_REGISTRY_URL=http://localhost:8001

# Public address of the platform (the QR code in the PDF profile links to /api/v1/verify/candidates/{id})
PUBLIC_BASE_URL=http://localhost:3000

# Assessment & CAT Engine Parameters
CAT_MIN_ITEMS=12
CAT_MAX_ITEMS=25
CAT_TARGET_SE=0.30
MAX_FAMILY_EXPOSURE_RATE=0.25

# LLM & AI Engine (152-FZ Compliant)
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=MDFhMTIwOTItY2IwMC03MGM4LWIwODQtYTA3YzZkYTIzNWVkOjhkMGE5NzMyLTM1MDYtNGU1NC1hZDgxLTgyZTJlMzU1YWQ2Yg==
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
